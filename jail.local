#
# HTTP servers
#

[nginx-abuse-protect]
enabled   = true
port      = http,https
logpath   = /var/log/nginx/*.log
banaction = iptables-multiport
maxretry  = 1
findtime  = 3600
bantime   = 600

[recidive-nginx]
enabled   = true
logpath   = /var/log/fail2ban.log
banaction = iptables-multiport
maxretry  = 2
findtime  = 86400
bantime   = 3600

[nginx-ddos-protect]
enabled   = true
port      = http,https
logpath   = /var/log/nginx/*.log
banaction = iptables-multiport
maxretry  = 1
findtime  = 3600
bantime   = 300

[nginx-prod-double-slash]
enabled  = true
port     = http,https
filter   = nginx-prod-double-slash
logpath  = /var/log/nginx/error.log
          /var/log/nginx/prod_errror.log
maxretry = 1
findtime = 60
bantime  = 604800
action   = iptables[blocktype=DROP]

[nginx-query-ddos]
enabled  = true
port     = http,https
filter   = nginx-query-ddos
logpath  = /var/log/nginx/access.log
          /var/log/nginx/prod_access.log
maxretry = 1
findtime = 60
bantime  = 604800
action   = iptables[blocktype=DROP]